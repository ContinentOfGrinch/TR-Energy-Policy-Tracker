{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tr_ets",
  "description": "Turkish ETS parameters. Populated but NOT wired into any calculation in v1. The schema keeps status_in_v1 explicit so nobody can switch it on by accident.",
  "type": "object",
  "required": ["meta", "why_deferred", "pilot_period", "scope"],

  "properties": {
    "_comment": { "type": "string" },

    "meta": {
      "type": "object",
      "required": ["parameter_set", "retrieved_date", "source_url", "status_in_v1"],
      "properties": {
        "parameter_set":  { "const": "tr_ets" },
        "regime_id":      { "const": "TR_ETS" },
        "version":        { "type": "string" },
        "retrieved_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "status_in_v1": {
          "type": "string",
          "enum": ["not_applied", "applied"],
          "description": "Must stay not_applied until the offset engine is deliberately built."
        },
        "legal_basis":     { "type": "string" },
        "administrator":   { "type": "string" },
        "market_operator": { "type": "string" },
        "source_url":      { "type": "string", "minLength": 1 },
        "source_note":     { "type": "string" },
        "verification_status": {
          "type": "string",
          "enum": ["secondary_source_verified_primary_pending", "primary_source_verified"]
        }
      }
    },

    "why_deferred": {
      "type": "object",
      "required": ["summary", "becomes_material_from"],
      "description": "The deferral is a modelling decision with a reason, not an omission. Recording the reason is what lets it be revisited on evidence.",
      "properties": {
        "summary":               { "type": "string", "minLength": 1 },
        "implication":           { "type": "string" },
        "becomes_material_from": { "type": "integer", "minimum": 2026 }
      }
    },

    "pilot_period": {
      "type": "object",
      "required": ["start_year", "end_year", "free_allocation_share", "financial_obligation"],
      "properties": {
        "start_year":           { "type": "integer" },
        "end_year":             { "type": "integer" },
        "compliance_deadline":  { "type": "string" },
        "free_allocation_share": {
          "type": "number", "minimum": 0, "maximum": 1,
          "description": "100% free during the pilot. This is precisely why the CBAM offset is approximately zero and the deferral is correct rather than a simplification."
        },
        "allocation_method":    { "type": "string" },
        "financial_obligation": { "type": "boolean" },
        "purpose":              { "type": "string" }
      }
    },

    "first_compliance_period": {
      "type": "object",
      "required": ["start_year", "end_year"],
      "properties": {
        "start_year": { "type": "integer" },
        "end_year":   { "type": "integer" },
        "free_allocation_share": {
          "type": ["number", "null"], "minimum": 0, "maximum": 1,
          "description": "null is the correct value while secondary legislation is unpublished. Section 8.1: propagate the gap, do not guess it."
        },
        "free_allocation_note": { "type": "string" }
      }
    },

    "scope": {
      "type": "object",
      "required": ["threshold_tco2e_per_year", "sectors"],
      "properties": {
        "threshold_tco2e_per_year": { "type": "number", "exclusiveMinimum": 0 },
        "threshold_basis":          { "type": "string" },
        "sectors":     { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sector_note": { "type": "string" }
      }
    },

    "coverage_check_against_this_project": {
      "type": "object",
      "properties": {
        "comment":  { "type": "string" },
        "computed": { "type": "boolean" }
      }
    }
  }
}
